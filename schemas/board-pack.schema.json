{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rweisssieker-xp/tpg-scheduler-codex-plugin/schemas/board-pack.schema.json",
  "title": "Full Board Pack",
  "type": "object",
  "required": [
    "packType",
    "source",
    "generatedAt",
    "executive",
    "pmo",
    "projectLeader",
    "steeringAgenda",
    "decisionLog",
    "riskRegister",
    "statusSuggestions",
    "projectSpotlights",
    "evidenceLedger",
    "dataGaps",
    "accessIssues",
    "logicAssurance",
    "safety"
  ],
  "additionalProperties": true,
  "properties": {
    "packType": { "const": "full_board_pack" },
    "source": { "enum": ["d365_api", "offline_reviewed_snapshot"] },
    "generatedAt": { "type": "string" },
    "today": { "type": ["string", "null"] },
    "executive": {
      "type": "object",
      "required": ["summary", "topRisks", "topDecisions", "questions", "noSurpriseForecast"],
      "additionalProperties": true,
      "properties": {
        "summary": {
          "type": "object",
          "required": ["projectsReviewed", "criticalProjects", "unsafeProjects", "ceoAttention", "cioAttention", "topRisks", "openDecisions"],
          "additionalProperties": true
        },
        "topRisks": { "type": "array" },
        "topDecisions": { "type": "array" },
        "questions": { "type": "array" },
        "noSurpriseForecast": { "type": "array" }
      }
    },
    "pmo": {
      "type": "object",
      "required": ["summary", "workQueue", "controlFindings", "reportSuiteSummary"],
      "additionalProperties": true
    },
    "projectLeader": {
      "type": "object",
      "required": ["summary", "statusSuggestions", "queue"],
      "additionalProperties": true
    },
    "steeringAgenda": { "type": "array" },
    "decisionLog": { "type": "array" },
    "riskRegister": { "type": "array" },
    "statusSuggestions": { "type": "array" },
    "projectSpotlights": { "type": "array" },
    "evidenceLedger": { "type": "array" },
    "dataGaps": { "type": "array" },
    "accessIssues": { "type": "array" },
    "logicAssurance": {
      "type": "object",
      "required": ["summary", "checks", "assuranceLevel"],
      "additionalProperties": true
    },
    "safety": {
      "type": "object",
      "required": ["advisoryOnly", "canAutoSave", "crmWritesIncluded"],
      "additionalProperties": true,
      "properties": {
        "advisoryOnly": { "const": true },
        "canAutoSave": { "const": false },
        "crmWritesIncluded": { "const": false }
      }
    }
  }
}
