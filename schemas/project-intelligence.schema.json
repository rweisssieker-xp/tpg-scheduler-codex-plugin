{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rweisssieker-xp/tpg-scheduler-codex-plugin/schemas/project-intelligence.schema.json",
  "title": "Project Intelligence Pack",
  "type": "object",
  "required": ["preview", "portfolioRisks", "decisionRadar", "projectSafetyGates", "pmoControlTower", "maximumUsps"],
  "additionalProperties": true,
  "properties": {
    "preview": { "type": "array" },
    "portfolioRisks": { "type": "array" },
    "decisionRadar": { "type": "array" },
    "steeringAgenda": { "type": "array" },
    "decisionClosureItems": { "type": "array" },
    "riskLedger": { "type": "array" },
    "nudges": { "type": "array" },
    "nudgeDrafts": { "type": "array" },
    "calibrationReport": { "type": "object" },
    "liveDynamicsRunPlan": { "type": "object" },
    "executiveOnePager": { "type": "string" },
    "projectSafetyGates": {
      "type": "object",
      "required": ["summary", "projects", "topFindings"],
      "additionalProperties": true
    },
    "pmoControlTower": {
      "type": "object",
      "required": ["summary", "projects", "portfolioFindings"],
      "additionalProperties": true
    },
    "pmoStatusReport": {
      "type": "object",
      "required": ["filters", "summary", "projects", "pmoControlTower", "projectSafetyGates"],
      "additionalProperties": true,
      "properties": {
        "filters": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "projectStatusLabels": { "type": "array", "items": { "type": "string" } },
            "lastStatusBefore": { "type": ["string", "null"] },
            "lastStatusAfter": { "type": ["string", "null"] },
            "lastStatusOn": { "type": ["string", "null"] },
            "lastStatusContains": { "type": ["string", "null"] },
            "lastStatusMissing": { "type": "boolean" }
          }
        },
        "summary": {
          "type": "object",
          "required": ["projectsTotal", "projectsMatched", "projectsFilteredOut"],
          "additionalProperties": true
        },
        "projects": { "type": "array" }
      }
    },
    "pmoReportSuite": {
      "type": "object",
      "required": ["generatedAt", "filters", "summary", "reports"],
      "additionalProperties": true,
      "properties": {
        "summary": {
          "type": "object",
          "required": ["reportCount", "reportTypes", "projectsReviewed", "totalDataGaps"],
          "additionalProperties": true
        },
        "reports": {
          "type": "array",
          "minItems": 12,
          "items": {
            "type": "object",
            "required": ["reportType", "title", "generatedAt", "filters", "summary", "sections", "rows", "evidence", "dataGaps"],
            "additionalProperties": true
          }
        }
      }
    },
    "maximumUsps": {
      "type": "object",
      "required": ["layerType", "summary", "usps"],
      "additionalProperties": true,
      "properties": {
        "layerType": { "const": "maximum_usps" },
        "summary": {
          "type": "object",
          "required": ["uspCount", "implemented", "bestMvpUsp", "boldFollowUpUsp", "safetyPosture"],
          "additionalProperties": true
        },
        "usps": {
          "type": "array",
          "minItems": 12,
          "items": {
            "type": "object",
            "required": ["id", "title", "targetUser", "painSolved", "concreteBenefit", "technicalMechanism", "requiredData", "mvpImplementation", "risksAndTrustControls", "proofMetric", "feasibility", "uspScore", "implementationStatus", "advisoryOnly"],
            "additionalProperties": true
          }
        }
      }
    }
  }
}
