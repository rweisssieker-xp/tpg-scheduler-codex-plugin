{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rweisssieker-xp/tpg-scheduler-codex-plugin/schemas/project-intelligence.schema.json",
  "title": "Project Intelligence Pack",
  "type": "object",
  "required": ["preview", "portfolioRisks", "decisionRadar", "projectSafetyGates", "pmoControlTower", "maximumUsps", "pmoUsps", "boardPack"],
  "additionalProperties": true,
  "properties": {
    "preview": { "type": "array" },
    "portfolioRisks": { "type": "array" },
    "decisionRadar": { "type": "array" },
    "steeringAgenda": { "type": "array" },
    "decisionClosureItems": { "type": "array" },
    "riskLedger": { "type": "array" },
    "nudges": { "type": "array" },
    "nudgeDrafts": { "type": "array" },
    "calibrationReport": { "type": "object" },
    "liveDynamicsRunPlan": { "type": "object" },
    "executiveOnePager": { "type": "string" },
    "projectSafetyGates": {
      "type": "object",
      "required": ["summary", "projects", "topFindings"],
      "additionalProperties": true
    },
    "pmoControlTower": {
      "type": "object",
      "required": ["summary", "projects", "portfolioFindings"],
      "additionalProperties": true
    },
    "pmoStatusReport": {
      "type": "object",
      "required": ["filters", "summary", "projects", "pmoControlTower", "projectSafetyGates"],
      "additionalProperties": true,
      "properties": {
        "filters": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "projectStatusLabels": { "type": "array", "items": { "type": "string" } },
            "lastStatusBefore": { "type": ["string", "null"] },
            "lastStatusAfter": { "type": ["string", "null"] },
            "lastStatusOn": { "type": ["string", "null"] },
            "lastStatusContains": { "type": ["string", "null"] },
            "lastStatusMissing": { "type": "boolean" }
          }
        },
        "summary": {
          "type": "object",
          "required": ["projectsTotal", "projectsMatched", "projectsFilteredOut"],
          "additionalProperties": true
        },
        "projects": { "type": "array" }
      }
    },
    "statusSuggestionReport": {
      "type": "object",
      "required": ["reportType", "title", "generatedAt", "summary", "sections", "rows", "evidence", "dataGaps"],
      "additionalProperties": true,
      "properties": {
        "reportType": { "const": "status_suggestion" },
        "summary": {
          "type": "object",
          "required": ["projectsReviewed", "draftSuggestions", "kvAllowed", "needsReview", "canAutoSave"],
          "additionalProperties": true
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["projectId", "statusType", "proposedStatusText", "canUseKv", "requiresReview", "canAutoSave", "reasonCodes", "dataGaps"],
            "additionalProperties": true
          }
        }
      }
    },
    "pmoReportSuite": {
      "type": "object",
      "required": ["generatedAt", "filters", "summary", "reports"],
      "additionalProperties": true,
      "properties": {
        "summary": {
          "type": "object",
          "required": ["reportCount", "reportTypes", "projectsReviewed", "totalDataGaps"],
          "additionalProperties": true
        },
        "reports": {
          "type": "array",
          "minItems": 12,
          "items": {
            "type": "object",
            "required": ["reportType", "title", "generatedAt", "filters", "summary", "sections", "rows", "evidence", "dataGaps"],
            "additionalProperties": true
          }
        }
      }
    },
    "boardPack": {
      "type": "object",
      "required": ["packType", "source", "executive", "pmo", "projectLeader", "safety"],
      "additionalProperties": true,
      "properties": {
        "packType": { "const": "full_board_pack" },
        "source": { "enum": ["d365_api", "offline_reviewed_snapshot"] },
        "executive": {
          "type": "object",
          "required": ["summary", "topRisks", "topDecisions", "questions", "noSurpriseForecast"],
          "additionalProperties": true
        },
        "pmo": {
          "type": "object",
          "required": ["summary", "workQueue", "controlFindings", "reportSuiteSummary"],
          "additionalProperties": true
        },
        "projectLeader": {
          "type": "object",
          "required": ["summary", "statusSuggestions", "queue"],
          "additionalProperties": true
        },
        "safety": {
          "type": "object",
          "required": ["advisoryOnly", "canAutoSave", "crmWritesIncluded"],
          "additionalProperties": true,
          "properties": {
            "advisoryOnly": { "const": true },
            "canAutoSave": { "const": false },
            "crmWritesIncluded": { "const": false }
          }
        }
      }
    },
    "maximumUsps": {
      "type": "object",
      "required": ["layerType", "summary", "usps"],
      "additionalProperties": true,
      "properties": {
        "layerType": { "const": "maximum_usps" },
        "summary": {
          "type": "object",
          "required": ["uspCount", "implemented", "bestMvpUsp", "boldFollowUpUsp", "safetyPosture"],
          "additionalProperties": true
        },
        "usps": {
          "type": "array",
          "minItems": 12,
          "items": {
            "type": "object",
            "required": ["id", "title", "targetUser", "painSolved", "concreteBenefit", "technicalMechanism", "requiredData", "mvpImplementation", "risksAndTrustControls", "proofMetric", "feasibility", "uspScore", "implementationStatus", "advisoryOnly"],
            "additionalProperties": true
          }
        }
      }
    },
    "pmoUsps": {
      "type": "object",
      "required": ["layerType", "summary", "usps", "commandQueue", "evidenceLedger", "dataGaps"],
      "additionalProperties": true,
      "properties": {
        "layerType": { "const": "pmo_usps" },
        "summary": {
          "type": "object",
          "required": ["uspCount", "implemented", "projectsReviewed", "criticalWorkItems", "dataGaps", "executiveAttentionItems", "safetyPosture"],
          "additionalProperties": true
        },
        "usps": {
          "type": "array",
          "minItems": 15,
          "items": {
            "type": "object",
            "required": ["id", "title", "targetUser", "painSolved", "concreteBenefit", "technicalMechanism", "requiredData", "runtimeSignals", "recommendedActions", "dataGaps", "proofMetric", "risksAndTrustControls", "implementationStatus", "advisoryOnly"],
            "additionalProperties": true
          }
        },
        "commandQueue": { "type": "array" },
        "evidenceLedger": { "type": "array" },
        "dataGaps": { "type": "array" }
      }
    }
  }
}
